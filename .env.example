# Provider mặc định cho cả chat và embeddings: openai.
# Máy local chỉ làm harness (chạy app + Qdrant), LLM chạy trên OpenAI.
AI_PROVIDER=openai
# Có thể override riêng thành openai hoặc ollama; bỏ comment khi cần dùng.
# CHAT_PROVIDER=openai
# EMBEDDING_PROVIDER=openai

# Bắt buộc khi dùng OpenAI: lấy key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=auto

# Chỉ cần khi dùng Ollama (chat/embeddings local thay cho OpenAI).
# Chạy app bằng Docker: localhost trong container KHÔNG phải máy host,
# phải trỏ sang host bằng tên đặc biệt host.docker.internal (Docker
# Desktop Windows/Mac). Đồng thời cho Ollama trên máy host lắng nghe
# 0.0.0.0: đặt biến môi trường OLLAMA_HOST=0.0.0.0:11434 rồi khởi động
# lại Ollama. Chạy app không Docker thì giữ localhost như cũ.
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant (vector database). Khi chạy bằng Docker Compose, app tự dùng
# http://qdrant:6333 trong mạng nội bộ nên không cần sửa dòng này.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=home_knowledge
# Để trống khi chạy local không bật auth. Nếu Qdrant của bạn có API key thì điền vào.
# QDRANT_API_KEY=

# Tự train knowledge lúc container khởi động nếu Qdrant đang trống.
AUTO_INGEST_ON_START=true

RAG_TOP_K=5
RAG_ENABLED=true
RAG_CANDIDATE_K=20
RAG_MMR_LAMBDA=0.75
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
